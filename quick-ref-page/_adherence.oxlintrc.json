{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "art/**",
              "connectors/**",
              "lib/**",
              "ui_kits/card-game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Cormorant Garamond))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Cormorant Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardVariant'] > JSXAttribute > JSXIdentifier[name!=/^(?:connector|art|back|key|ref|className|style|children)$/]",
        "message": "<CardVariant> doesn't accept that prop. Declared props: connector, art, back."
      },
      {
        "selector": "JSXOpeningElement[name.name='ControlsVariant'] > JSXAttribute > JSXIdentifier[name!=/^(?:connector|art|back|key|ref|className|style|children)$/]",
        "message": "<ControlsVariant> doesn't accept that prop. Declared props: connector, art, back."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|v|e|key|ref|className|style|children)$/]",
        "message": "<HandCard> doesn't accept that prop. Declared props: key, v, e."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpellStageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|v|e|key|ref|className|style|children)$/]",
        "message": "<SpellStageCard> doesn't accept that prop. Declared props: key, v, e."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "CardVariant": {
        "replaces": []
      },
      "ControlsVariant": {
        "replaces": []
      },
      "HandCard": {
        "replaces": []
