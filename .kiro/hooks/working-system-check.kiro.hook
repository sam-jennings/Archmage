{
  "enabled": true,
  "name": "Working-system check (session brief)",
  "description": "Runs the drift checker and acts on the session brief per meta/process.md §0. Run this at the start of a work session.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `node meta/checks/check.mjs` from the project root. Treat its output as the session brief per meta/process.md §0: summarise the threads table and P1s in a couple of lines, fix any trivial flags (<2 min) immediately, add the rest to meta/QUEUE.md. Do not lecture about flags."
  }
}
